{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "java (buildArtifact): java programs",
			"type": "shell",
			"command": "javac",
			"args": [
				"-d",
				"${workspaceFolder}",
				"${workspaceFolder}/*.java"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent"
			},
			"dependsOn": "compileJava"
		},
		{
			"label": "compileJava",
			"type": "shell",
			"command": "javac",
			"args": [
				"-d",
				"${workspaceFolder}",
				"${workspaceFolder}/*.java"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent"
			}
		},
		{
			"label": "java (createJar)",
			"type": "shell",
			"command": "jar",
			"args": [
				"cf",
				"${workspaceFolder}/${workspaceFolderBasename}.jar",
				"-C",
				"${workspaceFolder}",
				"."
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent"
			},
			"dependsOn": "compileJava"
		}
	]
}
